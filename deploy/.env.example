# Copy to .env and change the passwords.

# Host port for the web server (http://localhost:8080/)
OPENKIS_HTTP_PORT=8080
TZ=Europe/Rome

# Database (MariaDB container). The app connects as OPENKIS_DB_USER.
OPENKIS_DB_NAME=openkis
OPENKIS_DB_USER=openkis
OPENKIS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Where data is stored on the host. Empty = Docker named volumes
# (openkis_www, openkis_db), as before. Set a path (absolute, or ./relative
# to this folder) to keep the data in a host folder instead, e.g. on a
# dedicated disk. Missing folders are created on first start.
#   OPENKIS_DATA_DIR    -> web root /var/www/html (code + misc/: uploads, data)
#   OPENKIS_DB_DATA_DIR -> MariaDB data /var/lib/mysql
OPENKIS_DATA_DIR=
OPENKIS_DB_DATA_DIR=

# Regional customisation: a folder in extra/openkis/custom/
# (example, italia, liguria, lombardia, marche, piemonte, umbria, wish).
# Empty = generic installation.
OPENKIS_CUSTOM=

# MCP API (openkis_mcp.php): disabled while the key is empty
OPENKIS_MCP_APIKEY=
OPENKIS_MCP_USER=admin
OPENKIS_MCP_READONLY=0

# Optional map / search keys (written to the api_keys.local.js files)
THUNDERFOREST_API_KEY=
MAPTILER_API_KEY=
ALGOLIA_DOCSEARCH_API_KEY=

# PHP errors in the page (on = development only: warnings break exports)
OPENKIS_DISPLAY_ERRORS=off

# openkis_proxy.php is an open HTTP proxy (SSRF); only the Lombardia IGM map
# layer needs it. 1 = enable.
OPENKIS_ENABLE_PROXY=0

# Web image (default robydoc/openkis-web:latest). openkis-web:local = your own build.
#OPENKIS_IMAGE=robydoc/openkis-web:latest
