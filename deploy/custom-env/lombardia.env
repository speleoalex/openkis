# OpenKIS site for the Lombardia regional cave register.
# From the deploy/ folder, after changing the two passwords:
#   docker compose --env-file custom-env/lombardia.env up -d
# Then open http://localhost:8084/ and run the install wizard
# (the first user registered becomes the admin).
#
# Its own project name, port and database, so it can run next to other sites.

COMPOSE_PROJECT_NAME=openkis_lombardia

OPENKIS_HTTP_PORT=8084
TZ=Europe/Rome

OPENKIS_DB_NAME=openkis_lombardia
OPENKIS_DB_USER=openkis
OPENKIS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Regional customisation (extra/openkis/custom/lombardia)
OPENKIS_CUSTOM=lombardia
# Landing page: the cave map centred on Lombardia instead of the WISH portal
OPENKIS_HOME_SECTION=map_caves

# openkis_proxy.php (open HTTP proxy): needed by the Lombardia IGM map layer
OPENKIS_ENABLE_PROXY=1

OPENKIS_MCP_APIKEY=
OPENKIS_MCP_USER=admin
OPENKIS_MCP_READONLY=0

THUNDERFOREST_API_KEY=
MAPTILER_API_KEY=
ALGOLIA_DOCSEARCH_API_KEY=

OPENKIS_DISPLAY_ERRORS=off

# Web image (default robydoc/openkis-web:latest)
#OPENKIS_IMAGE=robydoc/openkis-web:latest
